# Copy to .env and adjust for local development.
# .env is git-ignored. Never commit real credentials.

# --- Web / Desktop ---
NODE_ENV=development
# Leave VITE_API_URL empty to use same-origin/relative URLs (Vite proxy in dev).
# Web production: set to the deployed API origin, e.g. https://api.example.com
# VITE_API_URL=http://localhost:4000
WEB_DEV_URL=http://localhost:5173

# --- Packaged desktop ---
# API base URL for the packaged Electron app (file:// origin cannot use
# relative URLs). Read by the Electron MAIN process — never expose it to the
# renderer via VITE_*; it reaches the renderer through the runtime-config IPC.
# Also set it when BUILDING the web dist used for packaging: the build-time
# CSP meta tag whitelists this origin in connect-src.
# ARP_API_BASE_URL=https://api.example.com

# --- API connection (for desktop dev mode) ---
# The desktop app loads the web dev server in development.
# The API URL is used by the web app's Vite proxy in development.
